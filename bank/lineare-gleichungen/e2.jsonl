{"id": "lineare-gleichungen-e2-k4-s1-v1", "eintrag": "lineare-gleichungen", "einheit": 2, "kette": "Umformen", "kette_nr": 4, "sprosse": 1, "sprosse_text": "Umkehroperation vertauscht", "merkmal": "Fehler finden: Minus statt Geteilt als Umkehrung von Mal", "hoehe": "pflicht", "pflicht": "fehler", "variante": 1, "aufgabe": "Jana rechnet: \\rechnung{3x &= 15 &&\\mid -3 \\\\ x &= 12} Finde den Fehler.", "form": "text", "antwort": "", "loesung": "Bei $3x$ wird mit 3 malgenommen, die Umkehrung ist $:3$, nicht $-3$. Richtig: $x = 5$.", "pruef": "5", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 65}
{"id": "lineare-gleichungen-e2-k4-s2-v1", "eintrag": "lineare-gleichungen", "einheit": 2, "kette": "Umformen", "kette_nr": 4, "sprosse": 2, "sprosse_text": "Seite wechseln ohne Umkehr", "merkmal": "Fehler finden: Zahl auf die andere Seite gebracht, ohne das Rechenzeichen umzukehren", "hoehe": "pflicht", "pflicht": "fehler", "variante": 1, "aufgabe": "Leo rechnet: \\rechnung{x + 8 &= 14 \\\\ x &= 14 + 8 \\\\ x &= 22} Finde den Fehler.", "form": "text", "antwort": "", "loesung": "Die 8 muss auf beiden Seiten abgezogen werden: $x = 14 - 8 = 6$.", "pruef": "6", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 63}
{"id": "lineare-gleichungen-e2-k4-s3-v1", "eintrag": "lineare-gleichungen", "einheit": 2, "kette": "Umformen", "kette_nr": 4, "sprosse": 3, "sprosse_text": "Nur ein Glied dividiert", "merkmal": "Fehler finden: beim Teilen nur ein Glied geteilt", "hoehe": "pflicht", "pflicht": "fehler", "variante": 1, "aufgabe": "Sara rechnet: \\rechnung{3x + 9 &= 21 &&\\mid :3 \\\\ x + 9 &= 7} Finde den Fehler.", "form": "text", "antwort": "", "loesung": "Beim Teilen durch 3 wird jedes Glied geteilt: $x + 3 = 7$, also $x = 4$ (einfacher: erst $-9$, dann $:3$).", "pruef": "4", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 64}
{"id": "lineare-gleichungen-e2-k4-s4-v1", "eintrag": "lineare-gleichungen", "einheit": 2, "kette": "Umformen", "kette_nr": 4, "sprosse": 4, "sprosse_text": "Begründen (warum darf man auf beiden Seiten …)", "merkmal": "begründen, warum die gleiche Umformung auf beiden Seiten die Lösung nicht ändert", "hoehe": "pflicht", "pflicht": "begruenden", "variante": 1, "aufgabe": "Warum darf man bei $x + 4 = 10$ auf beiden Seiten 4 abziehen?", "form": "text", "antwort": "", "loesung": "Beide Seiten sind gleich groß; zieht man von beiden dasselbe ab, bleiben sie gleich groß – die Lösung ändert sich nicht.", "pruef": "", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 20}
{"id": "lineare-gleichungen-e2-k4-s4-v2", "eintrag": "lineare-gleichungen", "einheit": 2, "kette": "Umformen", "kette_nr": 4, "sprosse": 4, "sprosse_text": "Begründen (warum darf man auf beiden Seiten …)", "merkmal": "begründen, warum die gleiche Umformung auf beiden Seiten die Lösung nicht ändert", "hoehe": "pflicht", "pflicht": "begruenden", "variante": 2, "aufgabe": "Warum rechnet man bei $5x + 3 = 28$ zuerst $-3$ und nicht zuerst $:5$?", "form": "text", "antwort": "", "loesung": "Beides ist erlaubt, aber mit $:5$ zuerst muss man auch 3 durch 5 teilen und bekommt Kommazahlen; mit $-3$ zuerst steht $5x$ allein.", "pruef": "", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 20}
{"id": "lineare-gleichungen-e2-k4-s4-v3", "eintrag": "lineare-gleichungen", "einheit": 2, "kette": "Umformen", "kette_nr": 4, "sprosse": 4, "sprosse_text": "Begründen (warum darf man auf beiden Seiten …)", "merkmal": "begründen, warum die gleiche Umformung auf beiden Seiten die Lösung nicht ändert", "hoehe": "pflicht", "pflicht": "begruenden", "variante": 3, "aufgabe": "Warum darf man nicht beide Seiten mit 0 malnehmen?", "form": "text", "antwort": "", "loesung": "Dann steht auf beiden Seiten 0 – das ist für jede Zahl wahr, die Gleichung verliert ihre Lösung.", "pruef": "", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 20}
