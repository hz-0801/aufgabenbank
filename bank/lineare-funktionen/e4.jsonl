{"id": "lineare-funktionen-e4-k4-s4-v1", "eintrag": "lineare-funktionen", "einheit": 4, "kette": "Gleichung bestimmen", "kette_nr": 4, "sprosse": 4, "sprosse_text": "aus zwei Punkten", "merkmal": "Anwendung: Gleichung aus zwei Messwerten", "hoehe": "pflicht", "pflicht": "anwendung", "variante": 1, "aufgabe": "Wie hoch ist die Grundgebühr? Für eine Taxifahrt von 4 km zahlt man 12{,}60 €, für 10 km 25{,}20 €. Der Preis setzt sich aus Grundgebühr und festem Preis je km zusammen.", "form": "gleichungsraster", "antwort": "__ €", "loesung": "$m = (25{,}20 - 12{,}60) : (10 - 4) = 2{,}10$; $n = 12{,}60 - 4 \\cdot 2{,}10 = 4{,}20$: Grundgebühr 4{,}20 €", "pruef": "[2.1, 4.2]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 24}
