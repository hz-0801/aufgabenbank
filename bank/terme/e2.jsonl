{"id": "terme-e2-k6-s1-v3", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 1, "sprosse_text": "Fehler finden", "merkmal": "typischen Fehler beim Zusammenfassen benennen und richtig rechnen", "hoehe": "pflicht", "pflicht": "fehler", "variante": 3, "aufgabe": "Lina soll den Term $6a - 2b + 3a$ zusammenfassen. Sie rechnet so: \\rechnung{6a - 2b + 3a &= 9a + 2b} Finde den Fehler und rechne richtig.", "form": "text", "antwort": "", "loesung": "Das Minus gehört zu $2b$ und ging beim Sortieren verloren. Richtig: $6a - 2b + 3a = 9a - 2b$.", "pruef": "6+3", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 22}
{"id": "terme-e2-k6-s2-v1", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 2, "sprosse_text": "Begründen (zusammenfassbar oder nicht)", "merkmal": "entscheiden und begründen, ob zusammengefasst werden darf", "hoehe": "pflicht", "pflicht": "begruenden", "variante": 1, "aufgabe": "Begründe, ob man den Term $4x + 4y$ zusammenfassen kann.", "form": "text", "antwort": "", "loesung": "Nein: $x$ und $y$ sind verschiedene Variablen, gleiche Vorzahlen reichen nicht.", "pruef": "", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 22}
{"id": "terme-e2-k6-s2-v2", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 2, "sprosse_text": "Begründen (zusammenfassbar oder nicht)", "merkmal": "entscheiden und begründen, ob zusammengefasst werden darf", "hoehe": "pflicht", "pflicht": "begruenden", "variante": 2, "aufgabe": "Begründe, ob man den Term $7z - z$ zusammenfassen kann.", "form": "text", "antwort": "", "loesung": "Ja: gleiche Variable, gleiche Hochzahl; $7z - z = 6z$.", "pruef": "", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 22}
{"id": "terme-e2-k6-s2-v3", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 2, "sprosse_text": "Begründen (zusammenfassbar oder nicht)", "merkmal": "entscheiden und begründen, ob zusammengefasst werden darf", "hoehe": "pflicht", "pflicht": "begruenden", "variante": 3, "aufgabe": "Begründe, ob man den Term $5b^2 + 5b$ zusammenfassen kann.", "form": "text", "antwort": "", "loesung": "Nein: $b^2$ und $b$ haben verschiedene Hochzahlen, die Glieder sind nicht gleichartig.", "pruef": "", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 22}
{"id": "terme-e2-k6-s3-v1", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 3, "sprosse_text": "Term aus Situation aufstellen und zusammenfassen", "merkmal": "Umfang aus der Figur als Term aufstellen und zusammenfassen", "hoehe": "pflicht", "pflicht": "darstellung", "variante": 1, "aufgabe": "Die Figur zeigt ein Rechteck. Die Maße sind in cm angegeben. Schreibe einen Term für den Umfang. Fasse den Term zusammen.", "form": "teil", "antwort": "__", "loesung": "$3x + 2 + 3x + 2 = 6x + 4$", "pruef": "6", "original": null, "grafik": "\\viereck[seiten={3x,2,3x,2}]{(0,0)}{(6,0)}{(6,2)}{(0,2)}", "loesungsgrafik": "", "quelle": 22}
{"id": "terme-e2-k6-s3-v2", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 3, "sprosse_text": "Term aus Situation aufstellen und zusammenfassen", "merkmal": "Umfang aus der Figur als Term aufstellen und zusammenfassen", "hoehe": "pflicht", "pflicht": "darstellung", "variante": 2, "aufgabe": "Die Figur zeigt ein Dreieck. Die Maße sind in cm angegeben. Schreibe einen Term für den Umfang. Fasse den Term zusammen.", "form": "teil", "antwort": "__", "loesung": "$4a + 2a + a = 7a$", "pruef": "7", "original": null, "grafik": "\\dreieck{(0,0)}{(6,0)}{(2,3)}{2a}{a}{4a}{}{}{}", "loesungsgrafik": "", "quelle": 22}
{"id": "terme-e2-k6-s3-v3", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 3, "sprosse_text": "Term aus Situation aufstellen und zusammenfassen", "merkmal": "Umfang aus der Figur als Term aufstellen und zusammenfassen", "hoehe": "pflicht", "pflicht": "darstellung", "variante": 3, "aufgabe": "Die Figur zeigt ein Viereck. Die Maße sind in cm angegeben. Schreibe einen Term für den Umfang. Fasse den Term zusammen.", "form": "teil", "antwort": "__", "loesung": "$2y + y + (y + 1) + 3 = 4y + 4$", "pruef": "4", "original": null, "grafik": "\\viereck[seiten={2y,y,y+1,3}]{(0,0)}{(5,0)}{(4,3)}{(0,3)}", "loesungsgrafik": "", "quelle": 22}
{"id": "terme-e2-k6-s4-v1", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 4, "sprosse_text": "Term aus Situation aufstellen und zusammenfassen", "merkmal": "Term aus einer Sachsituation aufstellen, zusammenfassen und damit eine Frage beantworten", "hoehe": "pflicht", "pflicht": "anwendung", "variante": 1, "aufgabe": "Ein Kiosk verkauft Brötchen zu je $p$ Euro. Am Montag verkauft er 45 Stück, am Dienstag 38 und am Mittwoch 52. Stelle einen Term für die Einnahmen der drei Tage auf und fasse ihn zusammen. Wie viel Euro nimmt der Kiosk bei $p = 0{,}40$ ein?", "form": "text", "antwort": "", "loesung": "$45p + 38p + 52p = 135p$; für $p = 0{,}40$: $135 \\cdot 0{,}40 = 54$ €", "pruef": "135*0.4", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 22}
{"id": "terme-e2-k6-s4-v2", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 4, "sprosse_text": "Term aus Situation aufstellen und zusammenfassen", "merkmal": "Term aus einer Sachsituation aufstellen, zusammenfassen und damit eine Frage beantworten", "hoehe": "pflicht", "pflicht": "anwendung", "variante": 2, "aufgabe": "Ein Beet ist $s$ Meter breit und doppelt so lang. Um das Beet kommt ein Zaun. Stelle einen Term für die Länge des Zauns auf und fasse ihn zusammen. Wie viele Meter Zaun braucht man bei $s = 8$?", "form": "text", "antwort": "", "loesung": "$s + 2s + s + 2s = 6s$; für $s = 8$: $6 \\cdot 8 = 48$ m", "pruef": "6*8", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 22}
{"id": "terme-e2-k6-s4-v3", "eintrag": "terme", "einheit": 2, "kette": "Zusammenfassen", "kette_nr": 6, "sprosse": 4, "sprosse_text": "Term aus Situation aufstellen und zusammenfassen", "merkmal": "Term aus einer Sachsituation aufstellen, zusammenfassen und damit eine Frage beantworten", "hoehe": "pflicht", "pflicht": "anwendung", "variante": 3, "aufgabe": "$n$ Schüler fahren auf Klassenfahrt. Jeder zahlt 85 € für die Unterkunft, 24 € für Eintritte und 36 € für die Bahn. Stelle einen Term für den Gesamtbetrag auf und fasse ihn zusammen. Wie viel Euro kommen bei 26 Schülern zusammen?", "form": "text", "antwort": "", "loesung": "$85n + 24n + 36n = 145n$; für $n = 26$: $145 \\cdot 26 = 3\\,770$ €", "pruef": "145*26", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 22}
