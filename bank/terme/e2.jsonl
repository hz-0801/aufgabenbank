{"id": "terme-e2-k1-s9-v1", "eintrag": "terme", "einheit": 2, "kette": "Malnehmen", "kette_nr": 1, "sprosse": 9, "sprosse_text": "Abschluss (Anwendung): Kantensumme und Volumen eines Quaders als Term (im Muster 4 nur das Volumen, ohne GYM)", "merkmal": "Sachaufgabe: Kantenlängen als Terme, Volumen durch Malnehmen", "hoehe": "sprosse", "variante": 1, "aufgabe": "Ein Quader ist $2x$ cm lang, $3x$ cm breit und 4 cm hoch. Stelle einen Term für das Volumen in cm³ auf. Wie groß ist das Volumen für $x = 5$?", "form": "text", "antwort": "", "loesung": "Volumen aufstellen: $2x \\cdot 3x \\cdot 4 = 24x^2$; einsetzen: $24 \\cdot 5^2 = 600$ cm³. Der Quader hat ein Volumen von 600 cm³.", "pruef": "24*5**2", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 105}
{"id": "terme-e2-k1-s9-v2", "eintrag": "terme", "einheit": 2, "kette": "Malnehmen", "kette_nr": 1, "sprosse": 9, "sprosse_text": "Abschluss (Anwendung): Kantensumme und Volumen eines Quaders als Term (im Muster 4 nur das Volumen, ohne GYM)", "merkmal": "Sachaufgabe: Kantenlängen als Terme, Volumen durch Malnehmen", "hoehe": "sprosse", "variante": 2, "aufgabe": "Eine Kiste hat die Form eines Quaders. Sie ist $a$ dm lang, $2a$ dm breit und 3 dm hoch. Stelle einen Term für das Volumen in dm³ auf. Passen 50 Liter Sand hinein, wenn $a = 2$ ist?", "form": "text", "antwort": "", "loesung": "Nein; Volumen aufstellen: $a \\cdot 2a \\cdot 3 = 6a^2$; einsetzen: $6 \\cdot 2^2 = 24$ dm³, das sind 24 Liter und damit weniger als 50 Liter.", "pruef": "6*2**2", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 105}
{"id": "terme-e2-k1-s9-v3", "eintrag": "terme", "einheit": 2, "kette": "Malnehmen", "kette_nr": 1, "sprosse": 9, "sprosse_text": "Abschluss (Anwendung): Kantensumme und Volumen eines Quaders als Term (im Muster 4 nur das Volumen, ohne GYM)", "merkmal": "Sachaufgabe: Kantenlängen als Terme, Volumen durch Malnehmen", "hoehe": "sprosse", "variante": 3, "aufgabe": "Ein Quader ist $3y$ cm lang, $2y$ cm breit und $y$ cm hoch. Stelle je einen Term für die Summe aller Kantenlängen und für das Volumen auf. Wie viel Draht braucht man für ein Kantenmodell mit $y = 5$?", "form": "text", "antwort": "", "loesung": "Kantensumme aufstellen: $4 \\cdot 3y + 4 \\cdot 2y + 4 \\cdot y = 24y$; Volumen aufstellen: $3y \\cdot 2y \\cdot y = 6y^3$; einsetzen: $24 \\cdot 5 = 120$ cm. Für das Kantenmodell braucht man 120 cm Draht.", "pruef": "[24, 6, 120]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 105}
{"id": "terme-e2-k1-s9-v4", "eintrag": "terme", "einheit": 2, "kette": "Malnehmen", "kette_nr": 1, "sprosse": 9, "sprosse_text": "Abschluss (Anwendung): Kantensumme und Volumen eines Quaders als Term (im Muster 4 nur das Volumen, ohne GYM)", "merkmal": "Sachaufgabe: Kantenlängen als Terme, Volumen durch Malnehmen", "hoehe": "sprosse", "variante": 4, "aufgabe": "Ein Quader ist $a$ cm lang, $2a$ cm breit und 3 cm hoch. Schreibe einen Term für das Volumen in cm³. Schreibe dann einen Term für die Länge aller 12 Kanten zusammen und fasse ihn zusammen.", "form": "text", "antwort": "", "loesung": "Volumen aufstellen: $a \\cdot 2a \\cdot 3 = 6a^2$; Kantensumme aufstellen: $4 \\cdot (a + 2a + 3) = 12a + 12$", "pruef": "[6, 12]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 105, "herkunft": "Blatt terme 2026-10-01b, Nr. 12c"}
