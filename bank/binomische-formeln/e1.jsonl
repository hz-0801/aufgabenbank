{"id": "binomische-formeln-e1-k3-s1-v1", "eintrag": "binomische-formeln", "einheit": 1, "kette": "Summe mal Summe", "kette_nr": 3, "sprosse": 1, "sprosse_text": "Fehler finden (nur Erstes mal Erstes und Letztes mal Letztes; Vorzeichen des Produkts; ungleichartig zusammengefasst)", "merkmal": "typischen Fehler bei Klammer mal Klammer benennen und richtig rechnen", "hoehe": "pflicht", "pflicht": "fehler", "variante": 1, "aufgabe": "Finde den Fehler und rechne richtig: \\rechnung{(x + 6) \\cdot (x + 4) &= x^2 + 24}", "form": "text", "antwort": "", "loesung": "Fehler: nur Erstes mal Erstes und Letztes mal Letztes, die beiden mittleren Produkte fehlen. Richtig: $x^2 + 10x + 24$.", "pruef": "10", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 19}
{"id": "binomische-formeln-e1-k3-s1-v2", "eintrag": "binomische-formeln", "einheit": 1, "kette": "Summe mal Summe", "kette_nr": 3, "sprosse": 1, "sprosse_text": "Fehler finden (nur Erstes mal Erstes und Letztes mal Letztes; Vorzeichen des Produkts; ungleichartig zusammengefasst)", "merkmal": "typischen Fehler bei Klammer mal Klammer benennen und richtig rechnen", "hoehe": "pflicht", "pflicht": "fehler", "variante": 2, "aufgabe": "Finde den Fehler und rechne richtig: \\rechnung{(x - 7) \\cdot (x - 2) &= x^2 - 9x - 14}", "form": "text", "antwort": "", "loesung": "Fehler: Minus mal Minus ergibt Plus, das letzte Glied ist positiv. Richtig: $x^2 - 9x + 14$.", "pruef": "-9", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 19}
{"id": "binomische-formeln-e1-k3-s1-v3", "eintrag": "binomische-formeln", "einheit": 1, "kette": "Summe mal Summe", "kette_nr": 3, "sprosse": 1, "sprosse_text": "Fehler finden (nur Erstes mal Erstes und Letztes mal Letztes; Vorzeichen des Produkts; ungleichartig zusammengefasst)", "merkmal": "typischen Fehler bei Klammer mal Klammer benennen und richtig rechnen", "hoehe": "pflicht", "pflicht": "fehler", "variante": 3, "aufgabe": "Finde den Fehler und rechne richtig: \\rechnung{(x + 7) \\cdot (2x + 1) &= 2x^2 + x + 14x + 7 \\\\ &= 17x^2 + 7}", "form": "text", "antwort": "", "loesung": "Fehler: $x^2$-Glieder und $x$-Glieder sind nicht gleichartig und wurden zusammengezählt. Richtig: $2x^2 + 15x + 7$.", "pruef": "2", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 19}
{"id": "binomische-formeln-e1-k3-s2-v1", "eintrag": "binomische-formeln", "einheit": 1, "kette": "Summe mal Summe", "kette_nr": 3, "sprosse": 2, "sprosse_text": "Begründen (warum vier Produkte entstehen – Flächenbild eines Rechtecks)", "merkmal": "am Rechteck begründen, warum vier Produkte entstehen", "hoehe": "pflicht", "pflicht": "begruenden", "variante": 1, "aufgabe": "Warum entstehen bei $(x + 2) \\cdot (y + 5)$ vier Produkte? Begründe am Flächenbild eines Rechtecks.", "form": "text", "antwort": "", "loesung": "Das Rechteck mit den Seiten $x + 2$ und $y + 5$ zerfällt in vier Teilrechtecke; jedes ist ein Stück der einen Seite mal ein Stück der anderen, also ein Produkt.", "pruef": "", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 19}
{"id": "binomische-formeln-e1-k3-s2-v2", "eintrag": "binomische-formeln", "einheit": 1, "kette": "Summe mal Summe", "kette_nr": 3, "sprosse": 2, "sprosse_text": "Begründen (warum vier Produkte entstehen – Flächenbild eines Rechtecks)", "merkmal": "am Rechteck begründen, warum vier Produkte entstehen", "hoehe": "pflicht", "pflicht": "begruenden", "variante": 2, "aufgabe": "Nina rechnet $(x + 4) \\cdot (x + 1) = x^2 + 4$. Begründe am Flächenbild eines Rechtecks, was fehlt.", "form": "text", "antwort": "", "loesung": "Das Rechteck hat vier Teilflächen: $x^2$, $x$, $4x$ und $4$. Nina lässt die zwei Rechtecke $x$ und $4x$ weg; richtig ist $x^2 + 5x + 4$.", "pruef": "", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 19}
{"id": "binomische-formeln-e1-k3-s2-v3", "eintrag": "binomische-formeln", "einheit": 1, "kette": "Summe mal Summe", "kette_nr": 3, "sprosse": 2, "sprosse_text": "Begründen (warum vier Produkte entstehen – Flächenbild eines Rechtecks)", "merkmal": "am Rechteck begründen, warum vier Produkte entstehen", "hoehe": "pflicht", "pflicht": "begruenden", "variante": 3, "aufgabe": "Ein Rechteck hat die Seiten $x + 9$ und $x + 2$. Begründe am Flächenbild, warum beim Ausmultiplizieren ein Glied mit $x$ entsteht, obwohl außen nur $x^2$ und eine Zahl stehen.", "form": "text", "antwort": "", "loesung": "Neben dem Quadrat $x^2$ und dem Zahlrechteck liegen zwei Streifen $9x$ und $2x$; sie ergeben zusammen das Glied $11x$: $x^2 + 11x + 18$.", "pruef": "", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 19}
