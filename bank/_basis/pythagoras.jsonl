{"id": "pythagoras-basis-k2-v1", "eintrag": "pythagoras", "einheit": 1, "kette": "Satz des Pythagoras formulieren", "kette_nr": 2, "sprosse": 1, "sprosse_text": "Satz des Pythagoras formulieren", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 1, "aufgabe": "Im Dreieck $ABC$ liegt der rechte Winkel bei $C$. Kreuze an, welche Gleichung gilt.\\\\ \\kreuz{$a^2 = b^2 + c^2$}\\\\ \\kreuz{$a^2 + b^2 = c^2$}\\\\ \\kreuz{$a + b = c$}", "form": "ankreuzen", "antwort": "", "loesung": "$a^2 + b^2 = c^2$", "pruef": "", "original": {"id": "2022-OS-B1g", "jahr": 2022, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 87, "ergebnis": ["B"]}
