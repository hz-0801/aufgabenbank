{"id": "pythagoras-basis-k2-v4", "eintrag": "pythagoras", "einheit": 1, "kette": "Satz des Pythagoras formulieren", "kette_nr": 2, "sprosse": 1, "sprosse_text": "Satz des Pythagoras formulieren", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 4, "aufgabe": "Kreuze an, welche Aussage in jedem rechtwinkligen Dreieck gilt.\\\\ \\kreuz{Die Katheten sind zusammen so lang wie die Hypotenuse.}\\\\ \\kreuz{Die Hypotenuse ist die längste Seite.}\\\\ \\kreuz{Eine Kathete ist länger als die Hypotenuse.}", "form": "ankreuzen", "antwort": "", "loesung": "Die Hypotenuse ist die längste Seite.", "pruef": "", "original": {"id": "2022-OS-B1g", "jahr": 2022, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 87, "ergebnis": ["B"]}
{"id": "pythagoras-basis-k2-v5", "eintrag": "pythagoras", "einheit": 1, "kette": "Satz des Pythagoras formulieren", "kette_nr": 2, "sprosse": 1, "sprosse_text": "Satz des Pythagoras formulieren", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 5, "aufgabe": "Im Dreieck $ABC$ liegt der rechte Winkel bei $B$. Kreuze an, welche Gleichung gilt.\\\\ \\kreuz{$a^2 - c^2 = b^2$}\\\\ \\kreuz{$a^2 + b^2 = c^2$}\\\\ \\kreuz{$a^2 + c^2 = b^2$}", "form": "ankreuzen", "antwort": "", "loesung": "$a^2 + c^2 = b^2$", "pruef": "", "original": {"id": "2022-OS-B1g", "jahr": 2022, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 87, "ergebnis": ["C"]}
{"id": "pythagoras-basis-k2-v6", "eintrag": "pythagoras", "einheit": 1, "kette": "Satz des Pythagoras formulieren", "kette_nr": 2, "sprosse": 1, "sprosse_text": "Satz des Pythagoras formulieren", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 6, "aufgabe": "Im Dreieck $PQR$ liegt der rechte Winkel bei $Q$; die Seiten heißen $p$, $q$, $r$ (gegenüber $P$, $Q$, $R$). Kreuze an, welche Gleichung gilt.\\\\ \\kreuz{$p^2 + r^2 = q^2$}\\\\ \\kreuz{$p^2 + q^2 = r^2$}\\\\ \\kreuz{$p + r = q$}", "form": "ankreuzen", "antwort": "", "loesung": "$p^2 + r^2 = q^2$", "pruef": "", "original": {"id": "2022-OS-B1g", "jahr": 2022, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 87, "ergebnis": ["A"]}
{"id": "pythagoras-basis-k2-v7", "eintrag": "pythagoras", "einheit": 1, "kette": "Satz des Pythagoras formulieren", "kette_nr": 2, "sprosse": 1, "sprosse_text": "Satz des Pythagoras formulieren", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 7, "aufgabe": "Kreuze an, welche Aussage der Satz des Pythagoras ist.\\\\ \\kreuz{Die beiden Kathetenquadrate sind zusammen doppelt so groß wie das Hypotenusenquadrat.}\\\\ \\kreuz{Das Hypotenusenquadrat ist so groß wie ein Kathetenquadrat.}\\\\ \\kreuz{Das Quadrat über der Hypotenuse hat denselben Flächeninhalt wie die beiden Kathetenquadrate zusammen.}", "form": "ankreuzen", "antwort": "", "loesung": "Das Quadrat über der Hypotenuse hat denselben Flächeninhalt wie die beiden Kathetenquadrate zusammen.", "pruef": "", "original": {"id": "2022-OS-B1g", "jahr": 2022, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 87, "ergebnis": ["C"]}
