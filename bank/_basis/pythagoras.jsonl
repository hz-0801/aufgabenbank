{"id": "pythagoras-basis-k1-v1", "eintrag": "pythagoras", "einheit": 1, "kette": "Pythagoras Gleichung zuordnen", "kette_nr": 1, "sprosse": 1, "sprosse_text": "Pythagoras Gleichung zuordnen", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 1, "aufgabe": "Kreuze an, welche Gleichung in diesem rechtwinkligen Dreieck gilt.\\\\ \\kreuz{$r^2 = p^2 + q^2$}\\\\ \\kreuz{$p^2 = q^2 + r^2$}\\\\ \\kreuz{$r^2 = p^2 - q^2$}\\\\ \\kreuz{$r = p + q$}", "form": "ankreuzen", "antwort": "", "loesung": "$r^2 = p^2 + q^2$", "pruef": "", "original": {"id": "2026-FOR-B1j", "jahr": 2026, "papier": "FOR"}, "grafik": "\\dreieckrw{3.5}{2.5}{p}{q}{r}", "loesungsgrafik": "", "quelle": 87, "ergebnis": ["A"]}
