{"id": "quadratische-funktionen-basis-k4-v1", "eintrag": "quadratische-funktionen", "einheit": 2, "kette": "Scheitelpunktform aufstellen", "kette_nr": 4, "sprosse": 1, "sprosse_text": "Scheitelpunktform aufstellen", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 1, "aufgabe": "Eine verschobene Normalparabel hat den Scheitelpunkt $S(2|-5)$. Kreuze an, welche Gleichung zu ihr gehört.\\\\ \\kreuz{$y = (x + 2)^2 - 5$}\\\\ \\kreuz{$y = (x - 2)^2 + 5$}\\\\ \\kreuz{$y = (x + 5)^2 + 2$}\\\\ \\kreuz{$y = (x - 2)^2 - 5$}", "form": "ankreuzen", "antwort": "", "loesung": "$y = (x - 2)^2 - 5$", "pruef": "", "original": {"id": "2016-OS-B1g", "jahr": 2016, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 104, "ergebnis": ["D"]}
{"id": "quadratische-funktionen-basis-k4-v2", "eintrag": "quadratische-funktionen", "einheit": 2, "kette": "Scheitelpunktform aufstellen", "kette_nr": 4, "sprosse": 1, "sprosse_text": "Scheitelpunktform aufstellen", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 2, "aufgabe": "Eine verschobene Normalparabel hat den Scheitelpunkt $S(-4|3)$. Kreuze an, welche Gleichung zu ihr gehört.\\\\ \\kreuz{$y = (x + 4)^2 - 3$}\\\\ \\kreuz{$y = (x - 3)^2 - 4$}\\\\ \\kreuz{$y = (x + 4)^2 + 3$}\\\\ \\kreuz{$y = (x - 4)^2 + 3$}", "form": "ankreuzen", "antwort": "", "loesung": "$y = (x + 4)^2 + 3$", "pruef": "", "original": {"id": "2016-OS-B1g", "jahr": 2016, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 104, "ergebnis": ["C"]}
{"id": "quadratische-funktionen-basis-k4-v3", "eintrag": "quadratische-funktionen", "einheit": 2, "kette": "Scheitelpunktform aufstellen", "kette_nr": 4, "sprosse": 1, "sprosse_text": "Scheitelpunktform aufstellen", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 3, "aufgabe": "Eine verschobene Normalparabel hat den Scheitelpunkt $S(4|2)$. Kreuze an, welche Gleichung zu ihr gehört.\\\\ \\kreuz{$y = (x - 2)^2 + 4$}\\\\ \\kreuz{$y = (x - 4)^2 + 2$}\\\\ \\kreuz{$y = (x + 4)^2 + 2$}\\\\ \\kreuz{$y = (x - 4)^2 - 2$}", "form": "ankreuzen", "antwort": "", "loesung": "$y = (x - 4)^2 + 2$", "pruef": "", "original": {"id": "2016-OS-B1g", "jahr": 2016, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 104, "ergebnis": ["B"]}
{"id": "quadratische-funktionen-basis-k4-v4", "eintrag": "quadratische-funktionen", "einheit": 2, "kette": "Scheitelpunktform aufstellen", "kette_nr": 4, "sprosse": 1, "sprosse_text": "Scheitelpunktform aufstellen", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 4, "aufgabe": "Eine verschobene Normalparabel hat den Scheitelpunkt $S(-1|-6)$. Kreuze an, welche Gleichung zu ihr gehört.\\\\ \\kreuz{$y = (x + 1)^2 - 6$}\\\\ \\kreuz{$y = (x - 1)^2 - 6$}\\\\ \\kreuz{$y = (x + 1)^2 + 6$}\\\\ \\kreuz{$y = (x + 6)^2 - 1$}", "form": "ankreuzen", "antwort": "", "loesung": "$y = (x + 1)^2 - 6$", "pruef": "", "original": {"id": "2016-OS-B1g", "jahr": 2016, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 104, "ergebnis": ["A"]}
{"id": "quadratische-funktionen-basis-k4-v5", "eintrag": "quadratische-funktionen", "einheit": 2, "kette": "Scheitelpunktform aufstellen", "kette_nr": 4, "sprosse": 1, "sprosse_text": "Scheitelpunktform aufstellen", "merkmal": "Basisaufgabe in Prüfungsform, ohne Rechner", "hoehe": "basis", "variante": 5, "aufgabe": "Eine verschobene Normalparabel hat den Scheitelpunkt $S(5|-2)$. Kreuze an, welche Gleichung zu ihr gehört.\\\\ \\kreuz{$y = (x + 5)^2 - 2$}\\\\ \\kreuz{$y = (x - 5)^2 + 2$}\\\\ \\kreuz{$y = (x + 2)^2 + 5$}\\\\ \\kreuz{$y = (x - 5)^2 - 2$}", "form": "ankreuzen", "antwort": "", "loesung": "$y = (x - 5)^2 - 2$", "pruef": "", "original": {"id": "2016-OS-B1g", "jahr": 2016, "papier": "OS"}, "grafik": "", "loesungsgrafik": "", "quelle": 104, "ergebnis": ["D"]}
