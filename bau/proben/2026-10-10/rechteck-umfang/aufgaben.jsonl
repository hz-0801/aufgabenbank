{"id": "flaechen-e1-k2-s5-v4", "eintrag": "flaechen", "einheit": 1, "kette": "Rechteck", "kette_nr": 2, "sprosse": 5, "sprosse_text": "Seite aus A", "merkmal": "Breite aus Fläche und aus Umfang", "hoehe": "sprosse", "variante": 4, "aufgabe": "Zwei Rechtecke sind beide 8\\,cm lang. (a) Das erste hat 48\\,cm² Fläche. (b) Das zweite hat 30\\,cm Umfang. Wie breit ist jedes?", "form": "teil", "antwort": "", "loesung": "(a) $b = 48 : 8 = 6$\\,cm; (b) $30 : 2 = 15$, $b = 15 - 8 = 7$\\,cm", "pruef": "[6, 15, 7]", "original": null, "grafik": "\\begin{tikzpicture}[scale=0.375,font=\\small]\\draw[line width=0.8pt] (0,0) -- (8,0) -- (8,5) -- (0,5) -- cycle;\\node[below] at (4.0,0.0) {8\\,cm};\\node[left] at (0.0,2.5) {$b$};\\node at (4.0,2.5) {$A = 48$\\,cm²};\\end{tikzpicture}", "loesungsgrafik": "", "quelle": 100, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/rechteck-umfang), Blatt 9WQ", "sache": "", "darstellung": "skizze-fertig", "frage": "laenge", "antwortform": "rechnen", "blatt": ["9WQ"], "abschnitt": "L1-B", "rolle": "beispiel", "modell_selbst_finden": "nein", "ergebnis": "(a) 6\\,cm (b) 7\\,cm", "schritte": ["(a) Fläche gegeben: teilen. $b = 48 : 8 = 6$, also 6\\,cm.", "Probe: $8 \\cdot 6 = 48$. Stimmt.", "(b) Umfang gegeben: erst halbieren. $30 : 2 = 15$ – das ist eine Länge und eine Breite zusammen.", "Dann die Länge abziehen: $b = 15 - 8 = 7$, also 7\\,cm.", "Probe: $2 \\cdot 8 + 2 \\cdot 7 = 16 + 14 = 30$. Stimmt."]}
