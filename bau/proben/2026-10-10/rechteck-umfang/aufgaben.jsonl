{"id": "flaechen-e1-k3-s1-v4", "eintrag": "flaechen", "einheit": 1, "kette": "aus Rechtecken zusammengesetzte Fläche (Summe)", "kette_nr": 3, "sprosse": 1, "sprosse_text": "aus Rechtecken zusammengesetzte Fläche (Summe)", "merkmal": "in zwei Rechtecke zerlegen, fehlende Seiten", "hoehe": "sprosse", "variante": 4, "aufgabe": "Ein Zimmer hat diesen Grundriss. Berechne Fläche und Umfang.", "form": "teil", "antwort": "", "loesung": "$A = 11 \\cdot 3 + 4 \\cdot 5 = 33 + 20 = 53$\\,m²; $u = 11 + 3 + 7 + 5 + 4 + 8 = 38$\\,m", "pruef": "[53, 38]", "original": null, "grafik": "\\begin{tikzpicture}[scale=0.236,font=\\small]\\draw[line width=0.8pt] (0,0) -- (11,0) -- (11,3) -- (4,3) -- (4,8) -- (0,8) -- cycle;\\draw[dashed,line width=0.4pt] (0,3) -- (4,3);\\node[below] at (5.5,0.0) {11\\,m};\\node[right] at (11.0,1.5) {3\\,m};\\node[above] at (2.0,8.0) {4\\,m};\\node[left] at (0.0,4.0) {8\\,m};\\end{tikzpicture}", "loesungsgrafik": "", "quelle": 23, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/rechteck-umfang), Blatt 9WQ", "sache": "Zimmer", "darstellung": "skizze-fertig", "frage": "laenge", "antwortform": "rechnen", "blatt": ["9WQ"], "abschnitt": "L1-D", "rolle": "beispiel", "modell_selbst_finden": "nein", "ergebnis": "$A = 53$\\,m², $u = 38$\\,m", "schritte": ["Fehlende Seiten: oben rechts $11 - 4 = 7$\\,m, innen senkrecht $8 - 3 = 5$\\,m.", "Zerlegen (gestrichelt): unten $11 \\cdot 3 = 33$\\,m², oben $4 \\cdot 5 = 20$\\,m².", "Fläche: $A = 33 + 20 = 53$\\,m².", "Umfang: alle sechs Randseiten addieren, $u = 11 + 3 + 7 + 5 + 4 + 8 = 38$\\,m."]}
