{"id": "potenzen-wurzeln-e1-k3-s1-v6", "eintrag": "potenzen-wurzeln", "einheit": 1, "kette": "Potenzen", "kette_nr": 3, "sprosse": 1, "sprosse_text": "Potenz als Malkette schreiben und ausrechnen, Malkette als Potenz", "merkmal": "Malkette in beide Richtungen", "hoehe": "grundfall", "variante": 6, "aufgabe": "Schreibe $6^3$ als Malkette und rechne aus. Schreibe $5 \\cdot 5 \\cdot 5 \\cdot 5$ als Potenz und rechne aus.", "form": "teil", "antwort": "", "loesung": "$6^3 = 6 \\cdot 6 \\cdot 6 = 216$; $5 \\cdot 5 \\cdot 5 \\cdot 5 = 5^4 = 625$", "pruef": "[216, 625]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 93, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/potenzen, A-bsp), Blatt VUD", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["VUD"], "abschnitt": "L1-A", "rolle": "beispiel", "modell_selbst_finden": "nein", "ergebnis": "$6^3 = 216$; \\ $5^4 = 625$", "schritte": ["Unten steht die Basis $6$, oben der Exponent $3$. Der Exponent sagt: drei Faktoren $6$. \\quad $6^3 = 6 \\cdot 6 \\cdot 6$", "Schritt für Schritt malnehmen: \\quad $6 \\cdot 6 = 36$, \\quad $36 \\cdot 6 = 216$. \\ Also $6^3 = 216$.", "Rückwärts: In $5 \\cdot 5 \\cdot 5 \\cdot 5$ steht viermal der Faktor $5$. Basis $5$, Exponent $4$: \\quad $5^4$", "Ausrechnen: \\quad $5 \\cdot 5 = 25$, \\ $25 \\cdot 5 = 125$, \\ $125 \\cdot 5 = 625$. \\ Also $5^4 = 625$."]}
