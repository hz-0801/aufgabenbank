{"id": "potenzen-wurzeln-e1-k3-s17-v4", "eintrag": "potenzen-wurzeln", "einheit": 1, "kette": "Potenzen", "kette_nr": 3, "sprosse": 17, "sprosse_text": "Sache: wiederholtes Vervielfachen (Verdoppeln, Falten, Teilen) als Potenz aufstellen, ausrechnen, entscheiden", "merkmal": "Falten mit anderer Dicke, gegen Höhe vergleichen", "hoehe": "pflicht", "pflicht": "anwendung", "variante": 4, "aufgabe": "Ein Stück Stoff ist $0{,}5$\\,mm dick. Es wird 5-mal in der Mitte gefaltet. Passt der Stapel noch in eine Schachtel, die 2\\,cm hoch ist?", "form": "teil", "antwort": "", "loesung": "Lagen: $2^5 = 32$; Dicke: $32 \\cdot 0{,}5 = 16$\\,mm $= 1{,}6$\\,cm. Ja, er passt (4\\,mm Platz).", "pruef": "[32, 16]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 93, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/potenzen, A-v4), Vorrat zu VUD", "sache": "Stoff falten", "darstellung": "text", "frage": "entscheidung", "antwortform": "rechnen", "blatt": [], "abschnitt": "L1-A", "rolle": "vorrat-gleich", "modell_selbst_finden": "ja", "ergebnis": "ja: $2^5 = 32$ Lagen, $16$\\,mm"}
{"id": "potenzen-wurzeln-e1-k3-s5-v4", "eintrag": "potenzen-wurzeln", "einheit": 1, "kette": "Potenzen", "kette_nr": 3, "sprosse": 5, "sprosse_text": "negative Basis mit Klammer, gerade und ungerade Hochzahl", "merkmal": "Klammer, ohne Klammer, Dezimalzahl, Bruch", "hoehe": "sprosse", "variante": 4, "aufgabe": "Berechne \\ a)~$(-5)^2$ \\qquad b)~$(-4)^3$ \\qquad c)~$-5^2$ \\qquad d)~$0{,}3^2$ \\qquad e)~$\\left(\\frac{3}{4}\\right)^2$", "form": "teil", "antwort": "", "loesung": "a) $(-5)^2 = 25$; b) $(-4)^3 = -64$; c) $-5^2 = -25$; d) $0{,}3^2 = 0{,}09$; e) $\\left(\\frac{3}{4}\\right)^2 = \\frac{9}{16}$", "pruef": "[25, -64, -25, 0.09, 9, 16]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 93, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/potenzen, B-bsp), Blatt VUD", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["VUD"], "abschnitt": "L1-B", "rolle": "beispiel", "modell_selbst_finden": "nein", "ergebnis": "a) $25$ \\ b) $-64$ \\ c) $-25$ \\ d) $0{,}09$ \\ e) $\\frac{9}{16}$", "schritte": ["Klammer: Die ganze Zahl $-5$ wird malgenommen. Minus mal Minus gibt Plus: \\quad $(-5)^2 = (-5) \\cdot (-5) = 25$", "Drei Faktoren mit Minus: \\quad $(-4) \\cdot (-4) \\cdot (-4) = 16 \\cdot (-4) = -64$", "Keine Klammer: Der Exponent gehört nur zur $5$, das Minus bleibt davor: \\quad $-5^2 = -(5 \\cdot 5) = -25$", "Dezimalzahl: \\quad $0{,}3 \\cdot 0{,}3$; \\ $3 \\cdot 3 = 9$, Kommastellen $1 + 1 = 2$: \\quad $0{,}3^2 = 0{,}09$", "Bruch: Zähler mal Zähler, Nenner mal Nenner: \\quad $\\left(\\frac{3}{4}\\right)^2 = \\frac{3 \\cdot 3}{4 \\cdot 4} = \\frac{9}{16}$"]}
