{"id": "potenzen-wurzeln-e1-k3-s10-v4", "eintrag": "potenzen-wurzeln", "einheit": 1, "kette": "Potenzen", "kette_nr": 3, "sprosse": 10, "sprosse_text": "Exponent durch wiederholtes Malnehmen bestimmen (P10-Form)", "merkmal": "vergleichen durch Ausrechnen; Exponent durch Malnehmen", "hoehe": "sprosse", "variante": 4, "aufgabe": "a)~Welche Zahl ist größer, $2^5$ oder $5^2$? \\qquad b)~Für welches $x$ gilt $3^x = 243$?", "form": "teil", "antwort": "", "loesung": "a) $2^5 = 32 > 25 = 5^2$; b) $3,\\ 9,\\ 27,\\ 81,\\ 243$: fünf Faktoren, $x = 5$", "pruef": "[32, 5]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 93, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/potenzen, C-bsp), Blatt VUD", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["VUD"], "abschnitt": "L1-C", "rolle": "beispiel", "modell_selbst_finden": "nein", "ergebnis": "a) $2^5 > 5^2$ \\ b) $x = 5$", "schritte": ["Beide ausrechnen: \\quad $2^5 = 2 \\cdot 2 \\cdot 2 \\cdot 2 \\cdot 2 = 32$, \\quad $5^2 = 5 \\cdot 5 = 25$. \\ Also $2^5 > 5^2$.", "Exponent finden: Die $3$ immer wieder malnehmen, bis $243$ dasteht: \\quad $3,\\ 9,\\ 27,\\ 81,\\ 243$", "Faktoren zählen: $243 = 3 \\cdot 3 \\cdot 3 \\cdot 3 \\cdot 3$, das sind fünf. \\ Also $x = 5$.", "Probe: \\quad $3^5 = 243$ \\checkmark"]}
