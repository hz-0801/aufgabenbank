{"id": "potenzen-wurzeln-e1-k3-s13-v4", "eintrag": "potenzen-wurzeln", "einheit": 1, "kette": "Potenzen", "kette_nr": 3, "sprosse": 13, "sprosse_text": "negative Hochzahl als Bruch, dann als Dezimalzahl", "merkmal": "Bruch, Dezimalzahl, vergleichen; hoch null", "hoehe": "sprosse", "variante": 4, "aufgabe": "Schreibe $5^{-2}$ als Bruch und als Dezimalzahl. Ist $5^{-2}$ größer oder kleiner als $0{,}05$? Berechne auch $9^0$.", "form": "teil", "antwort": "", "loesung": "$5^{-2} = \\frac{1}{25} = 0{,}04 < 0{,}05$; $9^0 = 1$", "pruef": "[0.04, 1]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 93, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/potenzen, D-bsp), Blatt VUD", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["VUD"], "abschnitt": "L1-D", "rolle": "beispiel", "modell_selbst_finden": "nein", "ergebnis": "$5^{-2} = \\frac{1}{25} = 0{,}04 < 0{,}05$; \\ $9^0 = 1$", "schritte": ["Minus in der Hochzahl heißt „1 geteilt durch“: \\quad $5^{-2} = \\frac{1}{5^2}$", "Unten ausrechnen: $5^2 = 25$, \\ also \\ $5^{-2} = \\frac{1}{25}$", "Als Dezimalzahl: erweitern auf Hundertstel: \\quad $\\frac{1}{25} = \\frac{4}{100} = 0{,}04$ \\quad (oder $1 : 25$)", "Vergleichen: \\quad $0{,}04 < 0{,}05$, \\ also \\ $5^{-2} < 0{,}05$", "Hoch null: $9^2 = 81$, \\ $9^1 = 9$, \\ $9^0 = 9 : 9 = 1$ \\ (jede Stufe tiefer: durch $9$ teilen)."]}
