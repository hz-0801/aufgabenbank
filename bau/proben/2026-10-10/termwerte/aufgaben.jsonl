{"id": "terme-e5-k1-s3-v6", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 3, "sprosse_text": "Quadrat bei negativer Einsetzung", "merkmal": "Quadrat mit Vorzahl oder einem zweiten Glied", "hoehe": "sprosse", "variante": 6, "aufgabe": "Berechne den Wert für $x = -2$. \\par\\vspace{3pt} a)~$4x^2$ \\qquad b)~$x^2 + 4$ \\qquad c)~$x^2 - x$", "form": "teil", "antwort": "", "loesung": "a) $4 \\cdot (-2)^2 = 4 \\cdot 4 = 16$; b) $(-2)^2 + 4 = 4 + 4 = 8$; c) $(-2)^2 - (-2) = 4 + 2 = 6$", "pruef": "[16, 8, 6]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, C2), Blatt MZE", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-C", "rolle": "aufgabe", "modell_selbst_finden": "nein", "ergebnis": "$16;\\ 8;\\ 6$"}
{"id": "terme-e5-k1-s3-v7", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 3, "sprosse_text": "Quadrat bei negativer Einsetzung", "merkmal": "Quadrat abziehen; negatives Ergebnis", "hoehe": "sprosse", "variante": 7, "aufgabe": "Berechne. \\par\\vspace{3pt} a)~$10 - x^2$ für $x = -3$ \\qquad b)~$2x^2 + 5x$ für $x = -1$", "form": "teil", "antwort": "", "loesung": "a) $10 - (-3)^2 = 10 - 9 = 1$; b) $2 \\cdot (-1)^2 + 5 \\cdot (-1) = 2 \\cdot 1 + (-5) = 2 - 5 = -3$", "pruef": "[1, -3]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, C3), Blatt MZE", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-C", "rolle": "aufgabe", "modell_selbst_finden": "nein", "ergebnis": "$1;\\ -3$"}
{"id": "terme-e5-k1-s8-v3", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 8, "sprosse_text": "Wertetabelle ausfüllen", "merkmal": "Wertetabelle mit Quadrat; das Vorzeichen der Werte entscheiden", "hoehe": "sprosse", "variante": 3, "aufgabe": "Berechne die Termwerte von $x^2 - 2x$ und trage sie in die Tabelle ein. Für welche Zahl $x$ ist der Termwert negativ?", "form": "tabelle", "antwort": "", "loesung": "$(-2)^2 - 2 \\cdot (-2) = 4 + 4 = 8$; $(-1)^2 - 2 \\cdot (-1) = 1 + 2 = 3$; $0^2 - 2 \\cdot 0 = 0$; $1^2 - 2 \\cdot 1 = 1 - 2 = -1$; $2^2 - 2 \\cdot 2 = 0$; $3^2 - 2 \\cdot 3 = 9 - 6 = 3$. Negativ nur für $x = 1$.", "pruef": "[8, 3, 0, -1, 0, 3]", "original": null, "grafik": "\\wertetabelle{x}{x^2 - 2x}{-2,-1,0,1,2,3}", "loesungsgrafik": "\\wertetabelle[8,3,0,-1,0,3]{x}{x^2 - 2x}{-2,-1,0,1,2,3}", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, C4), Blatt MZE", "sache": "", "darstellung": "tabelle", "frage": "entscheidung", "antwortform": "eintragen", "blatt": ["MZE"], "abschnitt": "L5-C", "rolle": "ziel", "modell_selbst_finden": "nein", "ergebnis": "$8;\\ 3;\\ 0;\\ -1;\\ 0;\\ 3$; negativ nur für $x = 1$"}
