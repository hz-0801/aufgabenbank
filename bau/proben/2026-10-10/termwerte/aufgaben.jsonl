{"id": "terme-e5-k1-s10-v2", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 10, "sprosse_text": "Termwerte vergleichen", "merkmal": "Termwerte vergleichen", "hoehe": "sprosse", "variante": 2, "aufgabe": "Welcher Term hat für $x = -3$ den größeren Wert: $5 - 3x$ oder $4 \\cdot (x + 6)$? Um wie viel ist er größer?", "form": "teil", "antwort": "", "loesung": "$5 - 3 \\cdot (-3) = 5 + 9 = 14$; $4 \\cdot (-3 + 6) = 4 \\cdot 3 = 12$. $5 - 3x$ hat den größeren Wert, um $14 - 12 = 2$.", "pruef": "[14, 12, 2]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, B-v4), Blatt MZE", "sache": "", "darstellung": "term", "frage": "unterschied", "antwortform": "rechnen", "blatt": [], "abschnitt": "L5-B", "rolle": "vorrat-gleich", "modell_selbst_finden": "nein", "ergebnis": "$5 - 3x$ (Wert $14$), um $2$ größer"}
{"id": "terme-e5-k1-s3-v4", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 3, "sprosse_text": "Quadrat bei negativer Einsetzung", "merkmal": "Quadrat bei negativer Einsetzung", "hoehe": "sprosse", "variante": 4, "aufgabe": "Berechne den Wert des Terms $2x^2 - 3x$ für $x = -4$.", "form": "teil", "antwort": "", "loesung": "$2 \\cdot (-4)^2 - 3 \\cdot (-4) = 2 \\cdot 16 - (-12) = 32 + 12 = 44$", "pruef": "44", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, C-bsp), Blatt MZE", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-C", "rolle": "beispiel", "modell_selbst_finden": "nein", "ergebnis": "$44$", "schritte": ["$-4$ in Klammern einsetzen: \\quad $2 \\cdot (-4)^2 - 3 \\cdot (-4)$", "Hochzahl zuerst: \\quad $(-4)^2 = (-4) \\cdot (-4) = 16$, \\ also \\ $2 \\cdot 16 - 3 \\cdot (-4)$", "Punkt vor Strich: \\quad $2 \\cdot 16 = 32$ \\ und \\ $3 \\cdot (-4) = -12$, \\ also \\ $32 - (-12)$", "Minus vor Minus wird Plus: \\quad $32 + 12 = 44$"]}
