{"id": "terme-e5-k1-s9-v2", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 9, "sprosse_text": "negative Zahl einsetzen, Klammer im Term", "merkmal": "negative Zahl einsetzen, Klammer im Term", "hoehe": "sprosse", "variante": 2, "aufgabe": "Berechne. \\par\\vspace{3pt} a)~$6 \\cdot (x - 1) + 20$ für $x = -2$ \\qquad b)~$10 - 2 \\cdot (x + 3)$ für $x = -7$", "form": "teil", "antwort": "", "loesung": "a) $6 \\cdot (-2 - 1) + 20 = 6 \\cdot (-3) + 20 = -18 + 20 = 2$; b) $10 - 2 \\cdot (-7 + 3) = 10 - 2 \\cdot (-4) = 10 - (-8) = 18$", "pruef": "[2, 18]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, B3), Blatt MZE", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-B", "rolle": "aufgabe", "modell_selbst_finden": "nein", "ergebnis": "$2;\\ 18$"}
{"id": "terme-e5-k1-s10-v1", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 10, "sprosse_text": "Termwerte vergleichen", "merkmal": "zwei Terme, eine Einsetzung; Werte vergleichen", "hoehe": "sprosse", "variante": 1, "aufgabe": "Welcher Term hat für $x = -2$ den größeren Wert: $3 - 4x$ oder $2 \\cdot (x + 6)$? Um wie viel ist er größer?", "form": "teil", "antwort": "", "loesung": "$3 - 4 \\cdot (-2) = 3 + 8 = 11$; $2 \\cdot (-2 + 6) = 2 \\cdot 4 = 8$. $3 - 4x$ hat den größeren Wert, um $11 - 8 = 3$.", "pruef": "[11, 8, 3]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, B4), Blatt MZE", "sache": "", "darstellung": "term", "frage": "unterschied", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-B", "rolle": "ziel", "modell_selbst_finden": "nein", "ergebnis": "$3 - 4x$ (Wert $11$), um $3$ größer"}
