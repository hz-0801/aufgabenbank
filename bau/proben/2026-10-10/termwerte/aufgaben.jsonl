{"id": "terme-e5-k1-s2-v4", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 2, "sprosse_text": "negative Zahl einsetzen, in Klammern", "merkmal": "ein Term, drei negative Einsetzungen", "hoehe": "sprosse", "variante": 4, "aufgabe": "Berechne den Wert von $3x + 10$ für \\ a)~$x = -2$ \\qquad b)~$x = -5$ \\qquad c)~$x = -1$.", "form": "teil", "antwort": "", "loesung": "a) $3 \\cdot (-2) + 10 = -6 + 10 = 4$; b) $3 \\cdot (-5) + 10 = -15 + 10 = -5$; c) $3 \\cdot (-1) + 10 = -3 + 10 = 7$", "pruef": "[4, -5, 7]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, B1), Blatt MZE", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-B", "rolle": "aufgabe", "modell_selbst_finden": "nein", "ergebnis": "$4;\\ -5;\\ 7$"}
