{"id": "terme-e5-k1-s8-v4", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 8, "sprosse_text": "Wertetabelle ausfüllen", "merkmal": "Wertetabelle ausfüllen", "hoehe": "sprosse", "variante": 4, "aufgabe": "Berechne die Termwerte von $x^2 + x$ und trage sie in die Tabelle ein. Für welche Zahlen $x$ ist der Termwert $0$?", "form": "tabelle", "antwort": "", "loesung": "$(-3)^2 + (-3) = 9 - 3 = 6$; $(-2)^2 + (-2) = 4 - 2 = 2$; $(-1)^2 + (-1) = 1 - 1 = 0$; $0^2 + 0 = 0$; $1^2 + 1 = 2$; $2^2 + 2 = 6$. Der Wert ist $0$ für $x = -1$ und $x = 0$.", "pruef": "[6, 2, 0, 0, 2, 6]", "original": null, "grafik": "\\wertetabelle{x}{x^2 + x}{-3,-2,-1,0,1,2}", "loesungsgrafik": "\\wertetabelle[6,2,0,0,2,6]{x}{x^2 + x}{-3,-2,-1,0,1,2}", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, C-v4), Blatt MZE", "sache": "", "darstellung": "tabelle", "frage": "entscheidung", "antwortform": "eintragen", "blatt": [], "abschnitt": "L5-C", "rolle": "vorrat-gleich", "modell_selbst_finden": "nein", "ergebnis": "$6;\\ 2;\\ 0;\\ 0;\\ 2;\\ 6$; null für $x = -1$ und $x = 0$"}
{"id": "terme-e5-k1-s12-v1", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 12, "sprosse_text": "Bruchstrich: Zähler und Nenner zuerst, negative Zahlen", "merkmal": "Bruchstrich: Zähler und Nenner zuerst, negative Zahlen", "hoehe": "sprosse", "variante": 1, "aufgabe": "Berechne den Wert des Terms $\\dfrac{a + b}{c}$ für $a = 3$, $b = -9$ und $c = -2$.", "form": "teil", "antwort": "", "loesung": "$\\dfrac{3 + (-9)}{-2} = (-6) : (-2) = 3$", "pruef": "3", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, D-bsp), Blatt MZE", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-D", "rolle": "beispiel", "modell_selbst_finden": "nein", "ergebnis": "$3$", "schritte": ["Jede Variable durch ihre Zahl ersetzen: \\quad $\\dfrac{3 + (-9)}{-2}$", "Oben und unten zuerst: \\quad Zähler $3 + (-9) = -6$, \\ Nenner $-2$", "Teilen: \\quad $(-6) : (-2) = 3$"]}
