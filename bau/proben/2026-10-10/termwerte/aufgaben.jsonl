{"id": "terme-e5-k1-s7-v1", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 7, "sprosse_text": "Klammer im Term, Variable mehrmals", "merkmal": "Klammer im Term, Variable mehrmals", "hoehe": "sprosse", "variante": 1, "aufgabe": "Berechne den Wert des Terms $3x + 2 \\cdot (x - 1)$ für $x = 4$.", "form": "teil", "antwort": "", "loesung": "$3 \\cdot 4 + 2 \\cdot (4 - 1) = 12 + 6 = 18$", "pruef": "18", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, A-bsp), Blatt MZE", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-A", "rolle": "beispiel", "modell_selbst_finden": "nein", "ergebnis": "$18$", "schritte": ["Für jedes $x$ die $4$ einsetzen; aus $3x$ wird $3 \\cdot 4$: \\quad $3 \\cdot 4 + 2 \\cdot (4 - 1)$", "Klammer zuerst: \\quad $4 - 1 = 3$, \\ also \\ $3 \\cdot 4 + 2 \\cdot 3$", "Punkt vor Strich: \\quad $12 + 6 = 18$", "Der Termwert ist $18$."]}
{"id": "terme-e5-k1-s1-v6", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 1, "sprosse_text": "Grundfall: Zahl für die Variable einsetzen, Punkt vor Strich", "merkmal": "ein Term, drei Einsetzungen; Malpunkt und Punkt vor Strich", "hoehe": "grundfall", "variante": 6, "aufgabe": "Berechne den Wert von $5x - 4$ für \\ a)~$x = 2$ \\qquad b)~$x = 3$ \\qquad c)~$x = 10$.", "form": "teil", "antwort": "", "loesung": "a) $5 \\cdot 2 - 4 = 10 - 4 = 6$; b) $5 \\cdot 3 - 4 = 15 - 4 = 11$; c) $5 \\cdot 10 - 4 = 50 - 4 = 46$", "pruef": "[6, 11, 46]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, A1), Blatt MZE", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-A", "rolle": "aufgabe", "modell_selbst_finden": "nein", "ergebnis": "$6;\\ 11;\\ 46$"}
{"id": "terme-e5-k1-s7-v2", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 7, "sprosse_text": "Klammer im Term, Variable mehrmals", "merkmal": "vier Terme, eine Zahl; Klammer und zweimal x", "hoehe": "sprosse", "variante": 2, "aufgabe": "Berechne den Wert für $x = 3$. \\par\\vspace{3pt} a)~$7 + 2x$ \\qquad b)~$4 \\cdot (x + 2)$ \\qquad c)~$20 - 3x$ \\qquad d)~$2x + x - 1$", "form": "teil", "antwort": "", "loesung": "a) $7 + 2 \\cdot 3 = 7 + 6 = 13$; b) $4 \\cdot (3 + 2) = 4 \\cdot 5 = 20$; c) $20 - 3 \\cdot 3 = 20 - 9 = 11$; d) $2 \\cdot 3 + 3 - 1 = 6 + 3 - 1 = 8$", "pruef": "[13, 20, 11, 8]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, A2), Blatt MZE", "sache": "", "darstellung": "term", "frage": "laenge", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-A", "rolle": "aufgabe", "modell_selbst_finden": "nein", "ergebnis": "$13;\\ 20;\\ 11;\\ 8$"}
{"id": "terme-e5-k1-s8-v1", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 8, "sprosse_text": "Wertetabelle ausfüllen", "merkmal": "Wertetabelle ausfüllen", "hoehe": "sprosse", "variante": 1, "aufgabe": "Berechne die Termwerte von $3x - 2$ und trage sie in die Tabelle ein.", "form": "tabelle", "antwort": "", "loesung": "$3 \\cdot 1 - 2 = 1$; $3 \\cdot 2 - 2 = 4$; $3 \\cdot 3 - 2 = 7$; $3 \\cdot 4 - 2 = 10$; $3 \\cdot 5 - 2 = 13$", "pruef": "[1, 4, 7, 10, 13]", "original": null, "grafik": "\\wertetabelle{x}{3x - 2}{1,2,3,4,5}", "loesungsgrafik": "\\wertetabelle[1,4,7,10,13]{x}{3x - 2}{1,2,3,4,5}", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, A3), Blatt MZE", "sache": "", "darstellung": "tabelle", "frage": "laenge", "antwortform": "eintragen", "blatt": ["MZE"], "abschnitt": "L5-A", "rolle": "aufgabe", "modell_selbst_finden": "nein", "ergebnis": "$1;\\ 4;\\ 7;\\ 10;\\ 13$"}
{"id": "terme-e5-k1-s13-v1", "eintrag": "terme", "einheit": 5, "kette": "Termwert", "kette_nr": 1, "sprosse": 13, "sprosse_text": "Formel aus einer Sache: einsetzen und entscheiden", "merkmal": "Zahl für die Variable aus dem Text, Ergebnis mit Geld vergleichen", "hoehe": "pflicht", "pflicht": "anwendung", "variante": 1, "aufgabe": "Ein Fahrradverleih berechnet den Preis in Euro mit dem Term $4 + 3h$ ($h$: Anzahl der Stunden). Tom hat 20\\,€ und möchte das Rad 6 Stunden leihen. Reicht sein Geld? Wie viel bleibt übrig oder fehlt?", "form": "teil", "antwort": "", "loesung": "$4 + 3 \\cdot 6 = 4 + 18 = 22$\\,€. Das Geld reicht nicht, es fehlen $22 - 20 = 2$\\,€.", "pruef": "[22, 2]", "original": null, "grafik": "", "loesungsgrafik": "", "quelle": 110, "herkunft": "Bau 2026-10-10 (bau/proben/2026-10-10/termwerte, A4), Blatt MZE", "sache": "Fahrradverleih", "darstellung": "text", "frage": "entscheidung", "antwortform": "rechnen", "blatt": ["MZE"], "abschnitt": "L5-A", "rolle": "ziel", "modell_selbst_finden": "ja", "ergebnis": "nein, $22$\\,€; es fehlen $2$\\,€"}
